{
  "version": 2,
  "buildCommand": "pnpm vercel-build",
  "installCommand": "pnpm install",
  "outputDirectory": ".",
  "builds": [
    {
      "src": "dist/src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "dist/src/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "dist/src/index.js"
    }
  ]
}
