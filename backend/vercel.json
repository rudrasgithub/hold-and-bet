{
  "version": 2,
  "buildCommand": "pnpm vercel-build",
  "installCommand": "pnpm install",
  "functions": {
    "dist/src/index.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/dist/src/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/src/index.js"
    }
  ]
}
